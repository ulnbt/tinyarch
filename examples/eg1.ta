; TinyArch v2 - assembly test program
; Computes sum of 1..10, stores result in r3
; Registers: r1 = counter, r2 = limit, r3 = accumulator

; --- Initialization ---
    1 -> r1        ; r1 = 1  (start counter at 1, using imm)
    10 -> r2       ; r2 = 10 (limit)
    0 -> r3        ; r3 = 0 (accumulator)
    
; Defining a label called "loop", this the position of "loop" used later
loop:
    r3 + r1 -> r3       ; accumulator += counter
    r1 + 1 -> r1        ; counter++
    if r1 > r2 jmp done ; if counter > limit, exit
    jmp loop            ; unconditional jump back to loop

done:
    HALT        ; Stops the machine, r3 should now hold 55 (1+2+...+10)