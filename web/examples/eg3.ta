; load seed into r1 

        1024 -> r3	; Store data at 0x400 
        2048 -> r4	; Generate 2k numbers
        0 -> r2
gen:
        if r2 == r4 jmp sort_init
        r1 << 13 -> r7
        r1 ^ r7 -> r1
        r1 >> 17 -> r7
        r1 ^ r7 -> r1
        r1 << 5  -> r7
        r1 ^ r7  -> r1
        r1 -> r3[r2]        
        r2 + 1 -> r2
        jmp gen
sort_init:
        1 -> r2
sort_outer:
        if r2 == r4 jmp done
        r3[r2] -> r6
        r2 - 1 -> r5
sort_inner:
        if 0 > r5 jmp insert
        r3[r5] -> r7
        if r7 <= r6 jmp insert
        r5 + 1 -> r8
        r7 -> r3[r8]            
        r5 - 1 -> r5
        jmp sort_inner
insert:
        r5 + 1 -> r7
        r6 -> r3[r7]        
        r2 + 1 -> r2
        jmp sort_outer
done:
        HALT
		
		